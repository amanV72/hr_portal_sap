<mvc:View
    controllerName="com.hr.hruiapp.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:l="sap.ui.layout"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:tnt="sap.tnt"
    displayBlock="true">

   



                            <!-- ================================ -->
                            <!-- MAIN CONTENT                    -->
                            <!-- ================================ -->
                            <VBox height="100%" width="100%" fitContainer="true">
                            <ScrollContainer
                                vertical="true"
                                horizontal="false"
                                height="90%"
                                width="95%"
                                class="hrWelcomeCard sapUiSmallMarginTop">

                                <!-- Page Header -->
                                <VBox class="sapUiSmallMarginBottom">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Title text="Employee Directory" level="H2" />
                                            <Text text="Manage your organization's workforce"
                                                  class="sapUiTinyMarginTop"
                                                  wrapping="false" />
                                        </VBox>
                                        <HBox alignItems="Center">
                                            <Button
                                                text="Bulk Upload"
                                                icon="sap-icon://upload"
                                                type="Default"
                                                class="sapUiSmallMarginEnd"
                                                press=".onBulkUpload" />
                                            <Button
                                                text="Add Employee"
                                                icon="sap-icon://add"
                                                type="Emphasized"
                                                press=".onAddEmployee" />
                                        </HBox>
                                    </HBox>
                                </VBox>

                                <!-- Search & Filter Bar -->
                              
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="SpaceBetween"
                                        alignContent="Stretch"
                                        width="100%"
                                        >
          
                                            <SearchField
                                                
                                                placeholder="Search by name, ID, or email..."
                                                search=".onSearch"
                                                liveChange=".onLiveSearch" >

                                                <layoutData>
                                                    <FlexItemData growFactor="1" />
                                                </layoutData>
                                                
                                                </SearchField>
                                            <HBox width="5px"></HBox>
                                            <Select
                                               
                                                change=".onDepartmentFilter"
                                                id="departmentFilter">
                                                <items>
                                                    <core:Item xmlns:core="sap.ui.core" key="ALL"         text="All Departments" />
                                                    <core:Item xmlns:core="sap.ui.core" key="ENGINEERING" text="Engineering" />
                                                    <core:Item xmlns:core="sap.ui.core" key="PRODUCT"     text="Product" />
                                                    <core:Item xmlns:core="sap.ui.core" key="DESIGN"      text="Design" />
                                                    <core:Item xmlns:core="sap.ui.core" key="HR"          text="HR" />
                                                    <core:Item xmlns:core="sap.ui.core" key="SALES"       text="Sales" />
                                                    <core:Item xmlns:core="sap.ui.core" key="ANALYTICS"   text="Analytics" />
                                                </items>
                                            </Select>
                                        </HBox>
                                   

                                <!-- Employee Table -->
                                <f:Card class="hrTableCard sapUiSmallMarginTop">
                                    <f:content>
                                        <Table
                                            id="employeeTable"
                                            items="{/employees}"
                                            showSeparators="Inner"
                                            mode="None"
                                            class="hrEmployeeTable">

                                            <columns >
                                                <Column width="8rem">
                                                    <Text text="ID" />
                                                </Column>
                                                <Column width="14rem">
                                                    <Text text="Name" />
                                                </Column>
                                               
                                                <Column>
                                                    <Text text="Role" />
                                                </Column>
                                                <Column>
                                                    <Text text="Department" />
                                                </Column>
                                                <Column>
                                                    <Text text="Status" />
                                                </Column>
                                                
                                            </columns>

                                            <items>
                                                <ColumnListItem
                                                    type="Navigation"
                                                    press=".onEmployeePress">
                                                    <cells>

                                                        <!-- ID -->
                                                        <Text text="{id}" />

                                                        <!-- Employee Name + Avatar -->
                                                        <HBox alignItems="Center">
                                                            <Avatar
                                                                src="{avatar}"
                                                                displaySize="XS"
                                                                class="sapUiSmallMarginEnd" />
                                                            <Text text="{name}" />
                                                        </HBox>

                                                        <!-- Role -->
                                                        <Text text="{role}" class="sapUiSmallPaddingBegin" />

                                                        <!-- Department Badge -->
                                                        <ObjectStatus text="{department}" />

                                                        <!-- Status Badge -->
                                                        <ObjectStatus
                                                            text="{status}"
                                                            state="{= ${status} === 'Active' ? 'Success' : ${status} === 'On Leave' ? 'Warning' : 'Error'}"
                                                            inverted="true" />

                                                        <!-- Action Menu -->
                                                        <Button
                                                            icon="sap-icon://overflow"
                                                            type="Transparent"
                                                            press=".onEmployeeActions" />

                                                    </cells>
                                                </ColumnListItem>
                                            </items>

                                        </Table>
                                    </f:content>
                                </f:Card>

                                <!-- Bottom Spacer -->
                                <VBox height="2rem" />

                            </ScrollContainer>
                            </VBox>

</mvc:View>